<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!-- 題目建議 Spring Boot 3，採用 3.5 系列最新修補版 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.16</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>

	<groupId>io.qiao</groupId>
	<artifactId>stock-holdings-tw</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>stock-holdings-tw</name>
	<description>Stock Holdings Ledger</description>

	<properties>
		<!-- 編譯成 Java 17 版本：考官電腦只要有 JDK 17 以上（17、21、25 都可以）就能執行 -->
		<java.version>17</java.version>
	</properties>

	<!-- 所有依賴都不寫版本號，交給 spring-boot-starter-parent 統一管理，避免版本衝突 -->
	<dependencies>

		<!-- 網頁 / REST API（內建 Tomcat 伺服器） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- 前端模板 Thymeleaf -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- 資料庫存取 Spring Data JPA（內含 Hibernate） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- 表單 / 參數驗證（@NotBlank、@Min 等註解） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- 資料表用 Flyway migration 建立（題目要求）；MySQL 需要額外的 flyway-mysql 模組 -->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-mysql</artifactId>
		</dependency>

		<!-- MySQL 驅動 -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Docker Compose 整合：執行 mvnw spring-boot:run 時，會自動依 docker-compose.yml 啟動 MySQL，
			並等資料庫準備好才啟動程式 → 達成題目「一行指令啟動」。
			打包成 jar 或跑測試時不會啟用。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-docker-compose</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- 開發工具：改程式後自動重啟（打包時不會包進去） -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- 測試 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- 測試專用 H2 記憶體資料庫（MySQL 相容模式）：讓 mvnw test 不需要開 Docker 也能跑 -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
